{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "esModuleInterop": true,
    "strict": true,
    

    "sourceMap": true,
    "declaration": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    /* Added for better TSOA compatibility */
"outDir": "./build",      // Correct: Output to a top-level 'build' folder
    "rootDir": "./src", 
    "typeRoots": ["./node_modules/@types", "./src/types","./@types",],
    "noImplicitAny": false, /* Temporarily disable to avoid issues with TSOA analysis */
    "moduleResolution": "node"
  },
  "include": ["src/**/*", "tsoa.json","@types/*"],
  "exclude": ["node_modules", "dist", "build"]
}
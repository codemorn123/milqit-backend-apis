# =====================================================
# REDIS CONFIGURATION (NEW)
# =====================================================
# Redis caching for faster API responses
# Works with or without Redis installed!

# Enable Redis (true for production, false for local dev)
REDIS_ENABLED=false

# Redis Connection (only needed if REDIS_ENABLED=true)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =====================================================
# CLOUDINARY CONFIGURATION
# =====================================================
# For image uploads and management
# Get credentials from: https://cloudinary.com

CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# =====================================================
# INSTRUCTIONS
# =====================================================
# 
# For Local Development:
# - Set REDIS_ENABLED=false (or omit it)
# - No Redis installation needed!
# - App uses in-memory cache automatically
#
# For Production:
# - Set REDIS_ENABLED=true
# - Configure REDIS_HOST, REDIS_PORT, REDIS_PASSWORD
# - Deploy with Redis server
#
# Note: If Redis connection fails, app automatically
# falls back to in-memory cache and continues working!

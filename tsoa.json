{
  "entryFile": "src/app.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": ["src/controllers/**/*.ts"],
  "spec": {
    "outputDirectory": "build",
    "specVersion": 3,
    "servers": [
      {
        "url": "http://localhost:5001/v1",
        "description": "Local Development Server"
      },
      {
        "url": "https://api.milqit.com/v1",
        "description": "Production Server"
      }
    ],
    "info": {
      "title": "Milqit E-commerce API",
      "version": "1.0.0",
      "description": "E-commerce API with admin and mobile interfaces"
    },
    "securityDefinitions": {
      "jwt": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "Enter JWT token with `Bearer <token>`"
      }
    },
    "security": [
      {
        "jwt": []
      }
    ],
    "swaggerUiAuth": {
      "persistAuthorization": true
    }
  },
  "swagger": {
    "outputDirectory": "./build",
    "host": "localhost:5001"
  },
  "routes": {
    "middleware": "express",
    "authenticationModule": "./src/middleware/auth-helper.ts",
    "routesFileName": "routes.ts",
    "routesDir": "src/generated"
  }
}